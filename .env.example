# Copy to .env. Only --backend openai sends API requests.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
AGENT_TEMPERATURE=0.2
AGENT_MAX_STEPS=18
AGENT_MAX_MODEL_CALLS=24
AGENT_MAX_TOKENS=24000
AGENT_MAX_COMPLETION_TOKENS=1024
AGENT_REQUEST_TIMEOUT=60
# Optional USD per million tokens. Leave blank when prices are unknown.
# Completion price includes reasoning tokens; they are not counted twice.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
# Optional monitor CPU price (USD/second), used in replay cost accounting.
MONITOR_PRICE_PER_SECOND=0
